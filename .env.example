# Hidden Benefits Navigator — server environment template.
# Names only. Never commit real values here; provision them through the
# deployment's secret storage or an ignored local .env file.

# TypeSafe / Jev credential used only by server code.
TYPESAFE_API_KEY=

# Pinned Jev model. A returned model that differs from this value is treated as
# an unevaluated configuration change, not an automatic upgrade.
JEV_MODEL=jev-1.13.0

# Signing secret for short-lived (15 minute) evaluation tokens.
EVALUATION_TOKEN_SECRET=

# Optional explicit-consent cloud text path (disabled unless both are set).
CLOUD_MODEL=
ANTHROPIC_API_KEY=
