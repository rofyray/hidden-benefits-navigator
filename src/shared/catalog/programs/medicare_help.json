{
  "id": "medicare_help",
  "name": "Help with Medicare costs",
  "jurisdiction": "US",
  "version": "0.1.0",
  "status": "published",
  "validFrom": "2026-01-01",
  "validTo": "2026-12-31",
  "reviewDueOn": "2026-12-01",
  "coverage": "One card covering two separate pathways: Medicare Savings Programs (MSP), which are state-run and help with Part A and Part B costs, and Extra Help, which is federal and helps with Part D drug costs. The two pathways keep separate evidence, separate limits and separate results; neither is ever used to justify the other.",
  "limitations": [
    "MSP and Extra Help are different programs with different limits; a result for one says nothing about the other.",
    "The federal limits shown are the floor: Texas may disregard some income or resources, so being over a limit is not a denial.",
    "Which income and resources count is decided by the agency; if that is not confirmed, the check stays unknown.",
    "The Texas MSP page could not be read, so no Texas-specific rule or document list is claimed.",
    "QDWI, working-disability and other special pathways are referred for help rather than scored."
  ],
  "eligibilitySummary": [
    "Medicare Savings Programs are run by Texas and can pay Part A and Part B premiums, and sometimes deductibles and copayments.",
    "Extra Help is run by Social Security and lowers what you pay for prescription drugs under Part D.",
    "Some people get Extra Help automatically, including people with full Medicaid, an MSP, or SSI.",
    "Each program decides separately, and states can count income and resources differently than the federal limits."
  ],
  "evidence": [
    {
      "id": "ev.medicare.msp_qmb",
      "text": "For 2026 the QMB program lists a monthly income limit of $1,350 and a resource limit of $9,950 for an individual, and $1,824 and $14,910 for a married couple. QMB helps with Part A and Part B premiums, deductibles, coinsurance and copayments.",
      "sourceIds": ["src.medicare.msp"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.msp_slmb",
      "text": "For 2026 the SLMB program lists a monthly income limit of $1,616 for an individual and $2,184 for a married couple, with the same $9,950 and $14,910 resource limits. SLMB helps with Part B premiums only and requires having both Part A and Part B.",
      "sourceIds": ["src.medicare.msp"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.msp_qi",
      "text": "For 2026 the QI program lists a monthly income limit of $1,816 for an individual and $2,455 for a married couple, with the same resource limits. QI must be applied for every year, is approved first come first served, and is only for people who do not qualify for other Medicaid coverage.",
      "sourceIds": ["src.medicare.msp"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.msp_qdwi",
      "text": "The QDWI program is for people who have a disability, are working, and lost Social Security disability benefits and premium-free Part A after returning to work; for 2026 it lists a monthly income limit of $5,405 for an individual and $7,299 for a couple, with resource limits of $4,000 and $6,000.",
      "sourceIds": ["src.medicare.msp"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.msp_state_variation",
      "text": "Medicare states that people may still qualify in their state even if income or resources are higher than the federal limits listed, because some states do not count certain types or amounts of income or resources, and advises applying even if you do not think you qualify.",
      "sourceIds": ["src.medicare.msp"],
      "kind": "caveat"
    },
    {
      "id": "ev.medicare.msp_apply",
      "text": "Medicare Savings Programs are run by the state and applications are made to the state, which determines which program or programs a person qualifies for.",
      "sourceIds": ["src.medicare.msp"],
      "kind": "application"
    },
    {
      "id": "ev.medicare.extra_help_limits",
      "text": "For 2026 Extra Help lists an income limit of $23,940 and a resource limit of $18,090 for an individual, and $32,460 and $36,100 for a married couple. These are annual income figures, not monthly.",
      "sourceIds": ["src.medicare.extra_help"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.extra_help_automatic",
      "text": "Extra Help is automatic for people who have full-benefit Medicaid coverage, who get help from their state paying Part B premiums through a Medicare Savings Program, or who get Supplemental Security Income.",
      "sourceIds": ["src.medicare.extra_help"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.extra_help_calendar",
      "text": "Extra Help runs on the calendar year: once qualified, a person keeps Extra Help through December 31 even if income changes mid-year.",
      "sourceIds": ["src.medicare.extra_help"],
      "kind": "caveat"
    },
    {
      "id": "ev.medicare.extra_help_apply",
      "text": "People who do not get Extra Help automatically can apply through Social Security, and a State Health Insurance Assistance Program offers free help applying; an Extra Help application also starts a Medicare Savings Program application with the state unless the applicant declines.",
      "sourceIds": ["src.medicare.extra_help", "src.medicare.ssa_apply"],
      "kind": "application"
    },
    {
      "id": "ev.medicare.texas_unreviewed",
      "text": "The Texas Health and Human Services page for Medicare Savings Programs returned HTTP 403 on September 19, 2026, so no Texas-specific rule, document list or local office is claimed here.",
      "sourceIds": ["src.medicare.texas_msp"],
      "kind": "caveat"
    },
    {
      "id": "ev.medicare.enrollment",
      "text": "Both pathways concern people who have Medicare; age by itself does not establish Medicare enrollment, which is a separate fact.",
      "sourceIds": ["src.medicare.msp", "src.medicare.extra_help"],
      "kind": "eligibility"
    },
    {
      "id": "ev.medicare.documents",
      "text": "Because the state decides which income and resources count and the Texas page could not be reviewed, the agency is the right place to confirm what to bring.",
      "sourceIds": ["src.medicare.msp", "src.medicare.texas_msp"],
      "kind": "document"
    }
  ],
